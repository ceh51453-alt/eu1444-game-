# Copy to .env.local and fill in.
#
# Đường proxy của dev server (Phần 1 mục 4a). Khi đặt biến này, mọi request tới
# /llm-proxy/... sẽ được Vite chuyển tiếp tới địa chỉ dưới đây, nên lúc phát
# triển không vướng CORS. Bật công tắc "Dùng proxy dev" trong tab Kết nối để
# engine gọi qua đường này.
#
# Bản build production KHÔNG có dev server, nên khi đó proxy thật buộc phải trả
# header CORS đúng.
VITE_DEV_PROXY_TARGET=https://proxy-cua-ban.example.com
